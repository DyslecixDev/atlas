# https://editorconfig.org
# Baseline editor settings for every contributor and editor, even those not
# running Biome. Biome owns code formatting, and this covers charset, EOL, and whitespace.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Markdown keeps trailing spaces because they can signal hard line breaks.
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab
